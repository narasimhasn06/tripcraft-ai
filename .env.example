# TripCraft AI Environment Configuration Example
# Copy this file to .env.local and fill in the values below.

# 1. Supabase Client Configuration
# Get these from your Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-project-anon-public-key

# 2. Supabase Edge Function Secrets (Optional for deployment)
# Configure this in your Supabase CLI or Dashboard Secrets, DO NOT commit this key or place it in client-side code!
# Run command: supabase secrets set OPENAI_API_KEY=your_openai_api_key
# OPENAI_API_KEY=your_openai_api_key

# 3. Test execution credentials (Used by scripts/*.mjs)
# Required for running verify-edge-function.mjs and verify-live-full.mjs
TEST_USER_EMAIL=tctest@mailinator.com
TEST_USER_PASSWORD=
TEST_USER_B_EMAIL=tctestb@mailinator.com
TEST_USER_B_PASSWORD=
